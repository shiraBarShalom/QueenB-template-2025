// ============================================================================
// Queens Match / MentorMe schema
// ============================================================================
// Identity already lives in the SQL tables created by
// server/db/migrations/001-004 (`users`, `user_profiles`, `mentor_profiles`,
// `user_roles`). Prisma maps onto those tables instead of creating a second
// "User" table. Matching / scheduling tables are added by
// 005_unify_prisma_matching.sql.
//
// Prisma field names stay camelCase for the services from main. Column names
// stay snake_case in PostgreSQL via @map / @@map.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum MentoringRequestStatus {
  WAITING_FOR_MENTOR_SLOTS
  WAITING_FOR_MENTEE_SELECTION
  REJECTED
  MATCHED
  ATTENDANCE_CONFIRMED
  COMPLETED
  NOT_COMPLETED
  FEEDBACK_COMPLETED
  CANCELLED
}

enum SchedulingRoundType {
  INITIAL
  EXTRA_SLOTS
  RESCHEDULE_BEFORE_MEETING
  RESCHEDULE_AFTER_NO_SHOW
}

enum MeetingStatus {
  SCHEDULED
  ATTENDANCE_CONFIRMED
  COMPLETED
  NOT_COMPLETED
  RESCHEDULED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum NotificationType {
  MENTORING_REQUEST_RECEIVED
  REQUEST_REJECTED
  SLOTS_AVAILABLE
  MEETING_MATCHED
  RESCHEDULE_REQUIRED
  MEETING_REMINDER
  ATTENDANCE_CONFIRMATION_REQUEST
  POST_MEETING_CHECK
  FEEDBACK_REMINDER
  MENTOR_THANK_YOU
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ----------------------------------------------------------------------------
// Core identity (existing SQL tables)
// ----------------------------------------------------------------------------

// users.id is BIGINT in PostgreSQL. Prisma uses Int here so API ids stay
// numbers. That is safe while ids stay in the 32-bit range.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("display_name") @db.VarChar(100)
  isAdmin      Boolean  @default(false) @map("is_admin")
  isActive     Boolean  @default(true) @map("is_active")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz
  disabledById Int?     @map("disabled_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  disabledBy    User?  @relation("UserDisabledBy", fields: [disabledById], references: [id], onDelete: SetNull)
  disabledUsers User[] @relation("UserDisabledBy")

  profile       UserProfile?
  mentorProfile MentorProfile?
  roles         UserRole[]
  technologies  Technology[]

  mentoringRequestsAsMentee     MentoringRequest[]
  attendanceConfirmations       AttendanceConfirmation[]
  meetingOutcomeConfirmations   MeetingOutcomeConfirmation[]
  feedbackAuthored              Feedback[]
  notifications                 Notification[]

  @@map("users")
}

model UserProfile {
  userId               Int      @id @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  background           String?
  linkedinUrl          String?  @map("linkedin_url")
  githubUrl            String?  @map("github_url")
  jobTitle             String?  @map("job_title") @db.VarChar(255)
  company              String?  @db.VarChar(255)
  yearsOfExperience    Int?     @map("years_of_experience")
  programmingLanguages String[] @default([]) @map("programming_languages")
  techStack            String[] @default([]) @map("tech_stack")
  onboardingComplete   Boolean  @default(false) @map("onboarding_complete")
  profileImageUrl      String?  @map("profile_image_url")
  phoneNumber          String?  @map("phone_number")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("user_profiles")
}

model UserRole {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, role])
  @@map("user_roles")
}

model Technology {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

// ----------------------------------------------------------------------------
// Mentor side (existing mentor_profiles + new topic list)
// ----------------------------------------------------------------------------

model MentorProfile {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique @map("user_id")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  background             String   @default("")
  meetingCapacity        Int?     @map("max_meetings")
  meetingDurationMinutes Int?     @map("meeting_duration_minutes")
  acceptingRequests      Boolean  @default(true) @map("accepting_requests")
  adviceTopics           String[] @default([]) @map("advice_topics")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  mentoringTopics           MentoringTopic[]
  mentoringRequestsReceived MentoringRequest[]

  @@map("mentor_profiles")
}

model MentoringTopic {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  mentorProfiles MentorProfile[]
}

// ----------------------------------------------------------------------------
// Mentoring lifecycle (new tables)
// ----------------------------------------------------------------------------

model MentoringRequest {
  id              Int                     @id @default(autoincrement())
  menteeId        Int
  mentee          User                    @relation(fields: [menteeId], references: [id])
  mentorProfileId Int
  mentorProfile   MentorProfile           @relation(fields: [mentorProfileId], references: [id])
  status          MentoringRequestStatus
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  schedulingRounds SchedulingRound[]
  meetings         Meeting[]
  notifications    Notification[]

  @@index([status])
  @@index([menteeId])
  @@index([mentorProfileId])
}

model SchedulingRound {
  id          Int                 @id @default(autoincrement())
  requestId   Int
  request     MentoringRequest    @relation(fields: [requestId], references: [id])
  roundNumber Int
  type        SchedulingRoundType
  createdAt   DateTime            @default(now())
  offeredSlots OfferedSlot[]

  @@unique([requestId, roundNumber])
}

model OfferedSlot {
  id                Int             @id @default(autoincrement())
  schedulingRoundId Int
  schedulingRound   SchedulingRound @relation(fields: [schedulingRoundId], references: [id], onDelete: Cascade)
  startTime         DateTime
  endTime           DateTime
  createdAt         DateTime        @default(now())
  meeting           Meeting?

  @@index([schedulingRoundId])
}

model Meeting {
  id             Int           @id @default(autoincrement())
  requestId      Int
  request        MentoringRequest @relation(fields: [requestId], references: [id])
  selectedSlotId Int?          @unique
  selectedSlot   OfferedSlot?  @relation(fields: [selectedSlotId], references: [id])
  attemptNumber  Int
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         MeetingStatus
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attendanceConfirmations AttendanceConfirmation[]
  outcomeConfirmations    MeetingOutcomeConfirmation[]
  feedback                Feedback[]
  notifications           Notification[]

  @@unique([requestId, attemptNumber])
  @@index([scheduledStart])
  @@index([status])
}

model AttendanceConfirmation {
  id          Int              @id @default(autoincrement())
  meetingId   Int
  meeting     Meeting          @relation(fields: [meetingId], references: [id])
  userId      Int
  user        User             @relation(fields: [userId], references: [id])
  status      AttendanceStatus
  confirmedAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([meetingId, userId])
}

model MeetingOutcomeConfirmation {
  id              Int      @id @default(autoincrement())
  meetingId       Int
  meeting         Meeting  @relation(fields: [meetingId], references: [id])
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  occurred        Boolean
  wantsReschedule Boolean?
  answeredAt      DateTime @default(now())

  @@unique([meetingId, userId])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  meetingId Int
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, authorId])
}

model Notification {
  id           Int                 @id @default(autoincrement())
  recipientId  Int
  recipient    User                @relation(fields: [recipientId], references: [id])
  requestId    Int?
  request      MentoringRequest?   @relation(fields: [requestId], references: [id])
  meetingId    Int?
  meeting      Meeting?            @relation(fields: [meetingId], references: [id])
  type         NotificationType
  channel      NotificationChannel
  status       NotificationStatus  @default(PENDING)
  scheduledAt  DateTime?
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime            @default(now())

  @@index([status])
  @@index([scheduledAt])
}
