PORT=5000

# Local PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=queenb
DB_USER=postgres
DB_PASSWORD=your_local_password

# Prisma / pg use this when present (takes precedence over the discrete DB_* vars)
DATABASE_URL="postgresql://postgres:your_local_password@localhost:5432/queenb"

# --- Authentication feature ---
# Session cookie signing secret. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be >= 32 chars. Required in production; a dev fallback is used if unset.
SESSION_SECRET=replace_with_a_generated_secret_of_at_least_32_characters

# Origin allowed to send credentialed API requests. Leave unset for local dev
# (CRA proxy is same-origin). Set to your deployed client URL in production.
CLIENT_ORIGIN=http://localhost:3000

# Set to "true" when the server runs behind a reverse proxy / load balancer.
TRUST_PROXY=false

# Password-reset token lifetime (minutes). The dev build logs the reset link
# to the server console; wire a real email provider in services/passwordResetService.js.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# --- Transactional email: meeting confirmation + mentor thank-you ---
# Provider: Nodemailer over SMTP (Gmail App Password recommended).
# Leave MAIL_HOST / MAIL_USER / MAIL_PASS unset in local dev: the server still
# boots and every feature works — email sending logs "delivery unavailable"
# and is skipped. Real secrets go ONLY in server/.env (gitignored).
#
# Gmail setup for the dedicated Match Queens account:
#   1. Sign in to the dedicated Gmail account.
#   2. Enable 2-Step Verification (myaccount.google.com/security).
#   3. Create an App Password (myaccount.google.com/apppasswords) — "Mail".
#   4. Put the 16-char value (no spaces) in MAIL_PASS below, in server/.env.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-match-queens-address@gmail.com
MAIL_PASS=your_16_char_gmail_app_password
MAIL_FROM="Match Queens <your-match-queens-address@gmail.com>"

# Locale for every email. The app has NO persisted per-user UI language, so all
# recipients get this one (he | ar | en; default he = the app's DEFAULT_LANG).
MAIL_DEFAULT_LOCALE=he
# IANA timezone used to format the meeting date/time in the email body. The
# calendar-link timestamps are UTC and unaffected by this.
MAIL_TZ=Asia/Jerusalem
# Optional: a publicly hosted logo URL. If empty, the bundled logo at
# server/assets/match-queens-logo.png is embedded inline via CID.
MAIL_LOGO_URL=

# --- WhatsApp Companion for mentors (feature/whatsapp-mentor) ---
# The bot identifies a mentor by her WhatsApp number and reads existing Match
# Queens data. Read-only: it never writes scheduling rows.
#
# ACTIVE TRANSPORT: 360dialog Sandbox.
#   Inbound:  360dialog Sandbox -> ngrok -> POST /api/whatsapp
#   Outbound: POST {D360_SANDBOX_BASE_URL}/v1/messages  with header D360-API-KEY
# Get the Sandbox API key from https://hub.360dialog.com (Sandbox / "Test API
# key"), then point the Sandbox webhook at your ngrok https URL + /api/whatsapp.
D360_API_KEY=your_360dialog_sandbox_api_key
D360_SANDBOX_BASE_URL=https://waba-sandbox.360dialog.io

# Interactive replies (quick-reply buttons / list messages):
#   auto (default) -> try interactive, auto-fallback to plain text on any error
#   on             -> same as auto (kept for clarity)
#   off            -> always send plain numbered text (pre-polish behaviour)
# Text commands (1 / בקשות, 2 / פגישות, 3 / עזרה, תפריט) always work regardless.
WHATSAPP_INTERACTIVE=auto

# --- Optional: Gemini natural-language understanding (thin layer) ---
# When set, a free-text Hebrew message that the deterministic parser does NOT
# recognise (e.g. "מה יש לי השבוע?") is classified by Gemini into ONE of the
# EXISTING WhatsApp actions and run through the SAME handlers as the buttons.
# If unset: that message just gets the "לא בטוחה שהבנתי" menu — buttons, "1/2/3"
# and "תפריט" keep working exactly as before. Get a key at aistudio.google.com.
GEMINI_API_KEY=
# Model + request timeout (ms). Defaults: gemini-2.5-flash, 6000.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=6000

# "Propose times from WhatsApp" multi-step flow: how long a mentor's pending
# availability / slot-preview is remembered server-side before it expires.
# In-memory only (single instance; lost on restart). Default 720000 (12 min).
WHATSAPP_PENDING_TTL_MS=720000

# Public origin of THIS server. Used to build the deep link to the React
# propose-slots page inside a reply. When you run ngrok, set this to the https
# forwarding URL it prints, e.g. APP_BASE_URL=https://a1b2c3d4.ngrok-free.dev
# If empty, falls back to CLIENT_ORIGIN, then http://localhost:3000.
APP_BASE_URL=

# --- Legacy Twilio transport (kept only for rollback) ---
# integrations/twilio.js is no longer wired into routes/whatsapp.js. These are
# unused while 360dialog is active; leave them or delete them freely.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=false

# Country code prepended to bare local numbers ("05..." -> "+972 5...") when
# enrolling / matching. Israel by default.
WHATSAPP_DEFAULT_COUNTRY_CODE=972
