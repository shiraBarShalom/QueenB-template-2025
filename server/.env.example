NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=false

DATABASE_URL=postgresql://mentorme_app:replace_app_password@localhost:5432/mentor_me
MIGRATION_DATABASE_URL=postgresql://mentorme_owner:replace_owner_password@localhost:5432/mentor_me
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

SESSION_SECRET=replace_with_a_generated_secret_of_at_least_32_characters

# Resend test mode can deliver only to the email address that owns the Resend account.
RESEND_API_KEY=re_replace_with_your_key
RESEND_FROM_EMAIL=MentorMe <onboarding@resend.dev>
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
