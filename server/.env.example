PORT=5000

# Local PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=queenb
DB_USER=postgres
DB_PASSWORD=your_local_password

# Prisma / pg use this when present (takes precedence over the discrete DB_* vars)
DATABASE_URL="postgresql://postgres:your_local_password@localhost:5432/queenb"

# --- Authentication feature ---
# Session cookie signing secret. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be >= 32 chars. Required in production; a dev fallback is used if unset.
SESSION_SECRET=replace_with_a_generated_secret_of_at_least_32_characters

# Origin allowed to send credentialed API requests. Leave unset for local dev
# (CRA proxy is same-origin). Set to your deployed client URL in production.
CLIENT_ORIGIN=http://localhost:3000

# Set to "true" when the server runs behind a reverse proxy / load balancer.
TRUST_PROXY=false

# Password-reset token lifetime (minutes). The dev build logs the reset link
# to the server console; wire a real email provider in services/passwordResetService.js.
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# --- Transactional email: meeting confirmation + mentor thank-you ---
# Provider: Nodemailer over SMTP (Gmail App Password recommended).
# Leave MAIL_HOST / MAIL_USER / MAIL_PASS unset in local dev: the server still
# boots and every feature works — email sending logs "delivery unavailable"
# and is skipped. Real secrets go ONLY in server/.env (gitignored).
#
# Gmail setup for the dedicated Match Queens account:
#   1. Sign in to the dedicated Gmail account.
#   2. Enable 2-Step Verification (myaccount.google.com/security).
#   3. Create an App Password (myaccount.google.com/apppasswords) — "Mail".
#   4. Put the 16-char value (no spaces) in MAIL_PASS below, in server/.env.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your-match-queens-address@gmail.com
MAIL_PASS=your_16_char_gmail_app_password
MAIL_FROM="Match Queens <your-match-queens-address@gmail.com>"

# Locale for every email. The app has NO persisted per-user UI language, so all
# recipients get this one (he | ar | en; default he = the app's DEFAULT_LANG).
MAIL_DEFAULT_LOCALE=he
# IANA timezone used to format the meeting date/time in the email body. The
# calendar-link timestamps are UTC and unaffected by this.
MAIL_TZ=Asia/Jerusalem
# Optional: a publicly hosted logo URL. If empty, the bundled logo at
# server/assets/match-queens-logo.png is embedded inline via CID.
MAIL_LOGO_URL=

# --- WhatsApp Companion for mentors (feature/whatsapp-mentor) ---
# Twilio WhatsApp Sandbox webhook -> POST /api/whatsapp. Read-only: the bot
# identifies a mentor by her WhatsApp number and reads existing Match Queens
# data. It never writes scheduling rows. Leave these unset in plain local dev
# (the webhook still works; signature validation just stays off with a warning).
#
# From the Twilio Console (console.twilio.com):
#   Account SID / Auth Token: top of the dashboard.
#   WhatsApp Sandbox number:  Messaging > Try it out > Send a WhatsApp message.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Whether to verify the X-Twilio-Signature header on the webhook.
#   true  -> always verify (needs TWILIO_AUTH_TOKEN + a correct APP_BASE_URL)
#   false -> never verify (convenient while wiring up the Sandbox locally)
#   unset -> verify in production; in dev verify only if TWILIO_AUTH_TOKEN is set
TWILIO_VALIDATE_SIGNATURE=false

# Public origin of THIS server, used to (a) rebuild the exact URL Twilio signed
# and (b) build the deep link to the React propose-slots page. When you run
# ngrok, set this to the https forwarding URL it prints, e.g.
#   APP_BASE_URL=https://a1b2c3d4.ngrok-free.app
# If left empty the server falls back to CLIENT_ORIGIN, then http://localhost:3000
# for the deep link, and to the request Host header for signature validation
# (set TRUST_PROXY=true if you rely on that behind a tunnel).
APP_BASE_URL=

# Country code prepended to bare local numbers ("05..." -> "+972 5...") when
# enrolling / matching. Israel by default.
WHATSAPP_DEFAULT_COUNTRY_CODE=972
